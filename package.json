{
  "name": "lbdluxecms",
  "version": "1.0.0",
  "description": "CMS for Lbdluxe",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "_dev": "cross-env NODE_OPTIONS='--no-deprecation --max-old-space-size=2048' next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS='--no-deprecation --max-old-space-size=2048' next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:schema": "payload-graphql generate:schema",
    "generate:types": "payload generate:types",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS='--no-deprecation --max-old-space-size=4096' payload migrate && next start"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.85.0",
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/email-resend": "3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/plugin-ecommerce": "3.85.0",
    "@payloadcms/plugin-form-builder": "^3.85.0",
    "@payloadcms/plugin-nested-docs": "^3.85.0",
    "@payloadcms/plugin-redirects": "^3.85.0",
    "@payloadcms/plugin-search": "^3.85.0",
    "@payloadcms/plugin-seo": "^3.85.0",
    "@payloadcms/richtext-lexical": "3.85.0",
    "@payloadcms/storage-s3": "^3.85.0",
    "@payloadcms/ui": "3.85.0",
    "@tailwindcss/postcss": "^4.3.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.14.0",
    "next": "15.4.11",
    "payload": "3.85.0",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.7.0",
    "sharp": "0.32.6",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1056.0",
    "@payloadcms/eslint-config": "^3.28.0",
    "@payloadcms/graphql": "3.85.0",
    "@swc/core": "^1.15.40",
    "@types/node": "25.9.3",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.4.11",
    "tsx": "^4.22.3",
    "typescript": "5.5.2"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
